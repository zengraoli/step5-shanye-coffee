{
  "name": "shanye-coffee-server",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "山野咖啡门店点单平台 API 服务（Fastify + TypeScript + SQLite）",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc",
    "start": "node dist/src/index.js",
    "typecheck": "tsc --noEmit",
    "test": "node --import tsx --test tests/*.test.ts",
    "smoke": "tsx scripts/smoke.ts"
  },
  "dependencies": {
    "@fastify/cors": "^10.0.2",
    "@fastify/swagger": "^9.9.0",
    "@fastify/swagger-ui": "^6.1.1",
    "fastify": "^5.2.1"
  },
  "devDependencies": {
    "@types/node": "^24.0.1",
    "tsx": "^4.19.2",
    "typescript": "^5.7.3"
  }
}
